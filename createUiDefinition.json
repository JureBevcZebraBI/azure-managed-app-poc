{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": { "basics": {} },
    "basics": [
      { "name": "vmName", "type": "Microsoft.Common.TextBox", "label": "VM Name", "defaultValue": "docker-vm", "constraints": { "required": true } },
      { "name": "adminUsername", "type": "Microsoft.Common.TextBox", "label": "Admin Username", "defaultValue": "azureuser", "constraints": { "required": true } },
      {
        "name": "adminPassword",
        "type": "Microsoft.Common.PasswordBox",
        "label": { "password": "Admin Password", "confirmPassword": "Confirm Password" },
        "constraints": { "required": true }
      },
      { "name": "containerImage", "type": "Microsoft.Common.TextBox", "label": "Docker Image", "defaultValue": "zebrabi.azurecr.io/dev-server:latest", "constraints": { "required": true } },
      { "name": "redisUri", "type": "Microsoft.Common.TextBox", "label": "REDIS_URI", "defaultValue": "redis://myredis:6379", "constraints": { "required": true } },
      { "name": "dbUri", "type": "Microsoft.Common.TextBox", "label": "DB_URI", "defaultValue": "postgres://mydb:5432", "constraints": { "required": true } },
      { "name": "registryServer", "type": "Microsoft.Common.TextBox", "label": "Registry Server", "defaultValue": "zebrabi.azurecr.io", "constraints": { "required": true } },
      { "name": "registryUsername", "type": "Microsoft.Common.TextBox", "label": "Registry Username", "defaultValue": "zebrabi", "constraints": { "required": true } },
      {
        "name": "registryPassword",
        "type": "Microsoft.Common.PasswordBox",
        "label": { "password": "Registry Password", "confirmPassword": "Confirm Password" },
        "constraints": { "required": true },
        "options": { "hideConfirmation": true }
      }
    ],
    "steps": [],
    "outputs": {
      "vmName": "[basics('vmName')]",
      "adminUsername": "[basics('adminUsername')]",
      "adminPassword": "[basics('adminPassword')]",
      "containerImage": "[basics('containerImage')]",
      "redisUri": "[basics('redisUri')]",
      "dbUri": "[basics('dbUri')]",
      "registryServer": "[basics('registryServer')]",
      "registryUsername": "[basics('registryUsername')]",
      "registryPassword": "[basics('registryPassword')]"
    }
  }
}